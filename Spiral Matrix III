class Solution:
    def spiralMatrixIII(self, rows, cols, rStart, cStart):
        res = []
        dirs = [(0,1),(1,0),(0,-1),(-1,0)]  # E, S, W, N
        
        steps = 1
        r, c = rStart, cStart
        
        if 0 <= r < rows and 0 <= c < cols:
            res.append([r,c])
        
        d = 0
        
        while len(res) < rows * cols:
            for _ in range(2):
                dr, dc = dirs[d % 4]
                
                for _ in range(steps):
                    r += dr
                    c += dc
                    
                    if 0 <= r < rows and 0 <= c < cols:
                        res.append([r,c])
                        if len(res) == rows * cols:
                            return res
                
                d += 1
            
            steps += 1
        
        return res
